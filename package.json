{
  "name": "ventura.million",
  "version": "1.0.0",
  "private": false,
  "type": "module",
  "description": "Framework local-first para criar, testar, executar, validar e exportar agentes e skills de IA — sem login obrigatório",
  "main": "src/cli/index.js",
  "bin": {
    "ventura": "src/cli/index.js"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "start": "node src/cli/index.js run",
    "test": "node --test tests/frontmatter.test.js tests/router.test.js tests/runtime.test.js tests/exporter.test.js tests/validator.test.js",
    "validate": "node src/cli/index.js validate",
    "doctor": "node src/cli/index.js doctor",
    "export": "node src/cli/index.js export --format json",
    "list": "node src/cli/index.js list"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/venturalabs-ai/ventura.million.git"
  },
  "keywords": [
    "ai-agents",
    "llm",
    "agent-framework",
    "portable",
    "local-first",
    "claude",
    "chatgpt",
    "grok",
    "copilot",
    "gemini",
    "mistral",
    "perplexity",
    "deepseek",
    "qwen"
  ],
  "author": "Ventura Labs AI",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/venturalabs-ai/ventura.million/issues"
  },
  "homepage": "https://github.com/venturalabs-ai/ventura.million#readme"
}
